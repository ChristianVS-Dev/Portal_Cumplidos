# ═══════════════════════════════════════════════════════════════════
# ENTORNO WEB (Vite dev / Docker nginx)
# Ubicación: frontend/.env  (opcional en dev local)
# ═══════════════════════════════════════════════════════════════════
#
# Infra y secretos del servidor → raíz/.env.docker (no aquí).
# Build APK Android → frontend/.env.mobile (ver .env.mobile.example).

# Web (Docker/nginx con proxy /api): ruta relativa
VITE_API_URL=/api/v1

# Debe coincidir con PORTAL_API_KEY del backend (misma clave, sin login de usuario)
# VITE_PORTAL_API_KEY=

# Logo del header (por defecto public/images/logo_gd.png)
# VITE_BRAND_LOGO=/images/logo_gd.png
