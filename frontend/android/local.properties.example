# Ruta del Android SDK (genere con Android Studio o copie este archivo a local.properties)
sdk.dir=C\:\\Users\\TU_USUARIO\\AppData\\Local\\Android\\Sdk

# Si Gradle falla con "JAVA_HOME is not set" en la terminal, use una de estas opciones:
