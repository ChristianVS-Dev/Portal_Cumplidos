# Copiar en el servidor del portal: cp .env.docker.example .env.docker
# docker compose --env-file .env.docker up -d --build api web
#
# Entornos del repo (orden):
#   .env.docker (esta carpeta, raíz)  → Docker + API + MySQL + SAP
#   frontend/.env                     → Dev web local (opcional)
#   frontend/.env.mobile              → Build APK Capacitor (npm run sync:env:mobile)
#
# La BD (intiva_qa) NO está en el servidor del portal: está en infra del cliente.
# El API solo abre TCP (host:puerto); no hace SSH. Defina la ruta según lo que entregue infra.

WEB_HOST_PORT=19080
CORS_ORIGIN=http://su-servidor-portal:19080
# App Android (Capacitor) — la APK llama al API del portal, NO a SAP (8100) ni a MySQL
# MOBILE_API_TARGET=emulator   → http://10.0.2.2:3001/api/v1 (API directo; requiere docker:dev:all)
# MOBILE_API_DIRECT=false      → usa WEB_HOST_PORT (19080) vía Vite/nginx
# MOBILE_API_TARGET=device     → requiere MOBILE_HOST_IP=192.168.x.x (teléfono en LAN)
# MOBILE_API_TARGET=server     → usa CORS_ORIGIN (producción / servidor desplegado)
# MOBILE_API_URL=              → URL fija (prioridad sobre MOBILE_API_TARGET)
# MOBILE_HOST_IP=
# CORS_ALLOW_CAPACITOR: el API acepta https://localhost desde Capacitor por defecto

PORTAL_API_KEY=

ENTREGAS_USE_MOCK=false
TRANSPORTES_USE_MOCK=false
PERSISTIR_CUMPLIDOS_MYSQL=true

# Pruebas con túnel SSH en Docker: docker compose --profile intiva --env-file .env.docker up -d --build
SSH_TUNNEL_HOST=172.16.29.5
SSH_TUNNEL_PORT=22
SSH_TUNNEL_USER=soporte
SSH_TUNNEL_PASSWORD="CLAVE_SSH_SOPORTE"
MYSQL_REMOTE_HOST=127.0.0.1
MYSQL_REMOTE_PORT=3306

MYSQL_HOST=intiva-tunnel
MYSQL_PORT=3306
MYSQL_USER=decor
MYSQL_PASSWORD="CLAVE_MYSQL_DECOR"
MYSQL_DATABASE=intiva_qa
MYSQL_CREATE_DATABASE=false
MYSQL_AUTO_MIGRATE=true

ENTREGAS_API_ENABLED=true
ENTREGAS_API_BASE_URL=http://10.10.10.5:8100/api/entregas
ENTREGAS_TIMEOUT_MS=20000
# Subida ZIP a SAP (ms). Independiente de ENTREGAS_TIMEOUT_MS; por defecto 180s en código
ENTREGAS_ADJUNTOS_TIMEOUT_MS=180000
ENTREGAS_API_TOKEN=
ENTREGAS_API_SEND_TOKEN_ON_READ=true

TRANSPORTES_ENABLED=true
TRANSPORTES_API_BASE_URL=http://10.10.10.5:8100/api/transportes
TRANSPORTES_TIMEOUT_MS=20000

SAP_USE_MOCK=false
SOPORTE_EMAIL=soporte.logistica@grupodecor.com

# --- Solo túnel SSH (opción B); no van al contenedor API ---
# SSH_TUNNEL_HOST=172.16.29.5
# SSH_TUNNEL_USER=soporte
# SSH_TUNNEL_LOCAL_PORT=3307
# MYSQL_REMOTE_HOST=127.0.0.1
# MYSQL_REMOTE_PORT=3306
