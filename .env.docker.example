# Copiar en el servidor: cp .env.docker.example .env.docker  (y completar valores)
# Luego: docker compose --env-file .env.docker up -d --build api web

WEB_HOST_PORT=19080
CORS_ORIGIN=http://su-servidor:19080

# Clave larga y aleatoria; misma en build del front (PORTAL_API_KEY en compose)
PORTAL_API_KEY=

ENTREGAS_USE_MOCK=false
TRANSPORTES_USE_MOCK=false
PERSISTIR_CUMPLIDOS_MYSQL=true

# MySQL Intiva (en el mismo servidor que el API en Docker suele ser host.docker.internal)
MYSQL_HOST=host.docker.internal
MYSQL_PORT=3306
MYSQL_USER=decor
MYSQL_PASSWORD="CAMBIAR_CLAVE_MYSQL"
MYSQL_DATABASE=intiva_qa
MYSQL_CREATE_DATABASE=false
MYSQL_AUTO_MIGRATE=true

ENTREGAS_API_ENABLED=true
ENTREGAS_API_BASE_URL=http://10.10.10.5:8100/api/entregas
ENTREGAS_TIMEOUT_MS=20000
ENTREGAS_API_TOKEN=
ENTREGAS_API_SEND_TOKEN_ON_READ=true

TRANSPORTES_ENABLED=true
TRANSPORTES_API_BASE_URL=http://10.10.10.5:8100/api/transportes
TRANSPORTES_TIMEOUT_MS=20000

SAP_USE_MOCK=false
SOPORTE_EMAIL=soporte.logistica@grupodecor.com
