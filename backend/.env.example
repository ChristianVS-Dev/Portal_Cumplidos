PORT=3001
NODE_ENV=development

# Métricas del portal (header). false = ceros sin leer MySQL
METRICAS_USE_DB=false

# MySQL (solo usa la base MYSQL_DATABASE; no afecta otras bases)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=portal_user
MYSQL_PASSWORD=
MYSQL_DATABASE=portal_cumplidos
# true = CREATE DATABASE IF NOT EXISTS antes de crear tablas
MYSQL_CREATE_DATABASE=false
# false = no auto-crear tablas al arrancar la API
MYSQL_AUTO_MIGRATE=true

# API 1 — GET /api/entregas/{vbeln}, POST .../adjuntos y POST .../intento (intento de entrega)
ENTREGAS_API_ENABLED=true
ENTREGAS_USE_MOCK=false
ENTREGAS_API_BASE_URL=http://10.10.10.5:8100/api/entregas
ENTREGAS_TIMEOUT_MS=20000
# Subida ZIP a SAP (ms). Independiente de ENTREGAS_TIMEOUT_MS; por defecto 180s en código
ENTREGAS_ADJUNTOS_TIMEOUT_MS=180000
# Token API entregas/transportes/adjuntos. Vacío = usa PORTAL_API_KEY
ENTREGAS_API_TOKEN=
# false = no envía token en GET consulta
ENTREGAS_API_SEND_TOKEN_ON_READ=true
# ENTREGAS_API_TOKEN_HEADER=Authorization
# ENTREGAS_API_TOKEN_PREFIX=Bearer

# API 2 — GET /api/transportes/{tknum} (tknum viene de la API 1)
TRANSPORTES_ENABLED=true
TRANSPORTES_USE_MOCK=false
TRANSPORTES_API_BASE_URL=http://10.10.10.5:8100/api/transportes
TRANSPORTES_TIMEOUT_MS=20000

# SAP legacy mock (solo si TRANSPORTES falla o está deshabilitado)
SAP_USE_MOCK=true
# true = al confirmar paso 3, todos los adjuntos van en un solo .zip a SAP
SAP_ADJUNTOS_ZIP=true
SAP_BASE_URL=
SAP_USER=
SAP_PASSWORD=
SAP_CLIENT=

# Archivos
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10
# true (default): borrar adjuntos del disco tras sync SAP ok (libera espacio)
UPLOAD_PURGE_AFTER_SAP_OK=true
# true: al arrancar el API, purga archivos locales ya sincronizados (una vez / mantenimiento)
UPLOAD_PURGE_LEGACY_ON_BOOT=false

# CORS
CORS_ORIGIN=http://localhost:5173

# Soporte (reportes sin conexión desde el portal)
SOPORTE_EMAIL=soporte.logistica@grupodecor.com

# SMTP (opcional; sin configurar se simula en consola)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Portal Cumplidos <noreply@grupodecor.com>
